{
  "name": "moi-builders-8",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MOI Builders #8 — Agentic Payments V2: everything session 7 does, plus a spend cap the chain enforces. The owner grants a capped, expiring allowance; the agent pays from it and cannot exceed it.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "verify-sdk": "tsx scripts/verify-sdk.ts",
    "preflight": "tsx scripts/preflight.ts",
    "setup:asset": "tsx scripts/00-setup-asset.ts",
    "setup:registry": "tsx scripts/01-register-agents.ts",
    "setup:authority": "tsx scripts/02-grant-authority.ts",
    "seller": "tsx packages/agent-seller/src/index.ts",
    "buyer": "tsx packages/agent-buyer/src/index.ts",
    "demo": "tsx scripts/demo.ts",
    "ask": "tsx scripts/ask.ts",
    "ui": "tsx scripts/ui.ts",
    "attack-test": "tsx scripts/attack-test.ts",
    "spike:allowance": "tsx scripts/spike-allowance.ts"
  },
  "dependencies": {
    "@demo/agent-buyer": "*",
    "@demo/agent-seller": "*",
    "@demo/shared": "*",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "groq-sdk": "^1.5.0",
    "js-moi-agent-registry": "0.1.1",
    "js-moi-sdk": "^0.7.1",
    "js-moi-utils": "^0.7.1",
    "js-polo": "^0.1.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
