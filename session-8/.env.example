# MOI Builders #7 — Agentic Payments V1.  Copy to .env and fill in.
# .env is gitignored. NEVER commit a mnemonic or an API key.
#
#   cp .env.example .env
#
# ONE funded MOI devnet wallet is enough. The BUYER is that wallet (it signs the payment, so it
# needs gas). The SELLER only ever RECEIVES, so it needs no funding at all.
# Fund at https://voyage.moi.technology

# ── Wallet (SECRET) ─────────────────────────────────────────────────────────
USER_MNEMONIC=
USER_DERIVATION_PATH=m/44'/6174'/7020'/0/0
# The seller's wallet. Same mnemonic, different path — it never signs, so it needs no funds.
SELLER_DERIVATION_PATH=m/44'/6174'/7020'/0/1

# ── Filled in by the setup scripts, in order ────────────────────────────────
# 00-setup-asset.ts     -> the native MAS0 asset used for payment
SETTLEMENT_ASSET_ID=
# 01-register-agents.ts -> on-chain agent ids
SELLER_AGENT_ID=
BUYER_AGENT_ID=

# ── Economics ───────────────────────────────────────────────────────────────
# The SELLER sets its prices per market, in packages/agent-seller/src/catalog.ts.
# This is only the fallback for a paid route with no catalog entry behind it.
PRICE_PER_ESTIMATE=1
ASSET_SYMBOL=USDM

# ── Services ────────────────────────────────────────────────────────────────
SELLER_URL=http://localhost:4011
BUYER_PORT=4001

# ── Agent brains (optional — both fall back to local logic) ─────────────────
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# NOTE: there is no LOGIC_ID and no budget here. Context inheritance and on-chain
# spend caps are SESSION 8.

# ── session 8: authority ────────────────────────────────────────────────────
# The agent's own account. It holds NO float — it spends the owner's, under an allowance.
AGENT_DERIVATION_PATH=m/44'/6174'/7020'/0/42
# What the owner is willing to let the agent spend, total, in base units.
AGENT_ALLOWANCE=5
# How long that grant stays valid, in seconds. The chain enforces the expiry.
ALLOWANCE_TTL_SECONDS=3600
