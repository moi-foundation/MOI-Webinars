# MOI Builders #8 — Agentic Payments V2 (authority).  Copy to .env and fill in.
# .env is gitignored. NEVER commit a mnemonic or an API key.
#
#   cp .env.example .env
#
# One funded MOI devnet wallet is enough: both agents are SUB-ACCOUNTS inherited
# from this primary. Fund it at https://voyage.moi.technology
# NOTE: sub-accounts share the primary's key — inheritance is not key isolation.
# What the chain enforces is the parent's spend cap, via the AgentBudget logic.

# ── Chain mode ──────────────────────────────────────────────────────────────
#   real (default)  hit MOI Voyage devnet. Needs a funded USER_MNEMONIC.
#   mock            run the WHOLE protocol in-process with an in-memory ledger.
#                   Real signatures, real verification, simulated settlement.
#                   Needs no .env at all:  CHAIN_MODE=mock pnpm demo
CHAIN_MODE=real

# ── Primary wallet (SECRET) ─────────────────────────────────────────────────
# Both agents are INHERITED SUB-ACCOUNTS of this one wallet. They share its key —
# inheritance is not key isolation. What it buys is on-chain actor state under the
# AgentBudget logic, which is what lets the chain enforce the cap.
USER_MNEMONIC=
USER_DERIVATION_PATH=m/44'/6174'/7020'/0/0

# ── Filled in by the setup scripts, in order ────────────────────────────────
# 00-setup-asset.ts   -> the native MAS0 asset used for settlement
SETTLEMENT_ASSET_ID=
# 01-deploy-budget.ts -> the AgentBudget logic id
LOGIC_ID=
# 03-register-agents.ts -> on-chain agent ids
SELLER_AGENT_ID=
BUYER_AGENT_ID=

# ── Sub-account indices (context inheritance) ───────────────────────────────
BUYER_SUBACCOUNT_INDEX=1
SELLER_SUBACCOUNT_INDEX=2

# ── Economics (base units of SETTLEMENT_ASSET_ID) ───────────────────────────
BUYER_BUDGET=500        # on-chain enforced cap for the buyer sub-account
PRICE_PER_BOOK=1        # what the seller charges per book

# ── Services ────────────────────────────────────────────────────────────────
FACILITATOR_URL=http://localhost:4021
SELLER_URL=http://localhost:4011
BUYER_PORT=4001

# ── Agent brains ────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# GROQ_MODEL=llama-3.3-70b-versatile
# AUTH_TTL_SECONDS=120
# FUEL_LIMIT=20000
# ASSET_SYMBOL=USDM

# Phase 2 (lockup / escrow) is OUT of the Phase 1 build target — no flag needed.
