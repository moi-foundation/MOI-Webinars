# MOI Builders #8 — Access policies. Copy to .env and fill in.
# .env is gitignored. NEVER commit a mnemonic.
#
#   cp .env.example .env
#
# ONE funded MOI devnet wallet is not quite enough here: BOTH accounts sign, so both need fuel.
# The owner registers the policies; the agent makes the calls. Fund both at
# https://voyage.moi.technology

# ── Wallet (SECRET) ─────────────────────────────────────────────────────────
USER_MNEMONIC=

# The OWNER — owns the storage the policy governs, and is the only account that can write it.
USER_DERIVATION_PATH=m/44'/6174'/7020'/0/0
# The AGENT — a separate key that calls the logic. Needs fuel to sign; nothing else.
AGENT_DERIVATION_PATH=m/44'/6174'/7020'/0/7

# ── Filled in by the setup scripts ──────────────────────────────────────────
# 01-deploy-ticker.ts -> the logic whose storage the policy governs
LOGIC_ID=

# ── Optional ────────────────────────────────────────────────────────────────
# FUEL_LIMIT=20000
# DEMO_PAUSE_MS=1500
