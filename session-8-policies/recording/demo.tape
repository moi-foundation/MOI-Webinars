# MOI Builders #8 — the access-policy demo, recorded live against MOI devnet.
# Every interaction here is real: two policy writes and three agent calls.
Output recording/demo.mp4
Output recording/demo.gif

Set Shell zsh
Set FontSize 16
Set Width 1500
Set Height 950
Set Theme "Catppuccin Mocha"
Set Padding 22
Set TypingSpeed 50ms

Type "# Same call. Same key. Three times."
Enter
Sleep 1500ms
Type "DEMO_PAUSE_MS=1200 npm run demo"
Enter
# Standalone run measured at 37s; +7s of narration pauses. 100s is generous.
Sleep 100s
