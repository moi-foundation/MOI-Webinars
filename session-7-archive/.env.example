# Session 7 — Agentic Payments (x402 × MOI)
# Copy to .env and fill in.  .env is gitignored repo-wide — NEVER commit a mnemonic.
#
#   cp .env.example .env
#
# You need TWO funded MOI devnet wallets (agent-a and agent-b), and optionally a THIRD for the
# facilitator. Create + fund them at:  https://voyage.moi.technology
# The faucet funds derivation path m/44'/6174'/7020'/0/0 — the default below.

# ── Wallets (SECRET) ────────────────────────────────────────────────────────────
# AGENT_A is the BUYER. It needs the MAS0 payment asset AND KMOI for fuel.
AGENT_A_MNEMONIC=""

# AGENT_B is the SELLER (the Signal Agent). It needs KMOI for fuel to register itself.
AGENT_B_MNEMONIC=""

# The FACILITATOR executes the settlement transfer, so it needs KMOI for fuel.
# For a simpler single-faucet demo you MAY reuse AGENT_B's mnemonic here — the flow still works,
# it just collapses the settlement and seller roles onto one wallet. Two wallets is more honest.
FACILITATOR_MNEMONIC=""

# Optional — all default to the Voyage faucet path.
# AGENT_A_DERIVATION_PATH=m/44'/6174'/7020'/0/0
# AGENT_B_DERIVATION_PATH=m/44'/6174'/7020'/0/0
# FACILITATOR_DERIVATION_PATH=m/44'/6174'/7020'/0/0

# ── Network ─────────────────────────────────────────────────────────────────────
# Settlement targets MOI Voyage devnet via VoyageProvider("devnet"), which resolves to:
#   https://dev.voyage-rpc.moi.technology/devnet/
# (verified live — see SDK_NOTES.md §1). No RPC URL needs to be set; this is FYI only.
# Faucet: https://voyage.moi.technology

# ── Filled in for you ───────────────────────────────────────────────────────────
# `npm run setup-asset` writes ASSET_ID here (mints the MAS0 "USDM" payment token).
ASSET_ID=
ASSET_SYMBOL=USDM
ASSET_DECIMALS=6

# `npm run register-agents` writes these (on-chain agent-registry ids).
AGENT_A_ID=
AGENT_B_ID=

# ── Demo knobs ──────────────────────────────────────────────────────────────────
# Price of one signal, in ATOMIC units of the asset. 1000 @ 6 decimals = 0.001 USDM.
SIGNAL_PRICE=1000

# How long a signed payment authorization stays valid, in seconds.
AUTH_TTL_SECONDS=120

FACILITATOR_PORT=4021
AGENT_B_PORT=4022
HOST=127.0.0.1
FUEL_LIMIT=50000

# ── Settlement backend ──────────────────────────────────────────────────────────
#   lockup  (default) real MAS0 Lockup -> Release -> Transfer on devnet. Needs funded wallets.
#   mock              in-memory. Runs the ENTIRE protocol — real signatures, real verification —
#                     but moves no funds and returns obviously-fake 0xmock… hashes. Use this to
#                     rehearse the demo, or on stage if the network is down.
SETTLEMENT=lockup

# ── Tier 2 (stretch) ────────────────────────────────────────────────────────────
# Escrowed pay-on-delivery. Same MAS0 lockup, but the facilitator only releases AFTER agent-b has
# returned a valid result — and refunds the buyer if it fails. Leave false for the Tier 1 demo;
# Tier 1 never depends on this being true.
ESCROW=false
