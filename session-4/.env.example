# Devnet-only demo wallets — two separate funded Voyage wallets.
# Fund both at https://voyage.moi.technology
# Copy to .env and fill in before running setup.js / swap-cli.js / npm run dev

VITE_ALICE_MNEMONIC=twelve word alice mnemonic here
VITE_BOB_MNEMONIC=twelve word bob mnemonic here

# Optional derivation paths (default is the Voyage faucet path for both)
# VITE_ALICE_PATH=m/44'/6174'/7020'/0/0
# VITE_BOB_PATH=m/44'/6174'/7020'/0/0

# Filled by setup.js — paste into .env for swap-cli.js and the UI
# VITE_TKA_ASSET_ID=
# VITE_TKB_ASSET_ID=
