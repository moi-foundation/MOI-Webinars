# Copy to .env and fill in. .env is gitignored — never commit it.
# The parser does NOT strip inline "# comments" — keep values comment-free.

# The deployed AgentBudget logic id (from `node deploy-budget.js`).
LOGIC_ID=

# MOI devnet is keyless via VoyageProvider("devnet"); this is unused there but
# kept for a local node. For devnet you can leave it as-is.
MOI_NODE_URL=https://dev.voyage-rpc.moi.technology/devnet/

# Your devnet account (SECRET). The Voyage faucet funds derivation index 7020.
USER_MNEMONIC=""
USER_DERIVATION_PATH="m/44'/6174'/7020'/0/0"
USER_ID=
USER_SUB_ACCOUNT=

# Claude API key — only needed for the `run` command (the real AI agent).
ANTHROPIC_API_KEY=

# Optional
FUEL_LIMIT=20000
